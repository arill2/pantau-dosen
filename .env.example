# Salin file ini menjadi .env lalu isi dengan kredensial proyek Supabase Anda.
# Ambil dari: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Domain internal untuk membuat akun admin dari "username".
# Contoh: username "admin" menjadi "admin@pantau-dosen.local" saat login.
VITE_AUTH_EMAIL_DOMAIN=pantau-dosen.local

# Branding aplikasi (opsional, ada nilai bawaan bila dikosongkan).
VITE_APP_NAME=Pantau Dosen
VITE_APP_SUBTITLE=Rekap pembelajaran taruna
VITE_INSTANSI=Politeknik Ilmu Pelayaran Makassar
